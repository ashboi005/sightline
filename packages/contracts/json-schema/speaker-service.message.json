{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ready"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "device": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "analysis_mode": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "minimum_samples": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "history_samples": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum_input_samples": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "noise_processor": {
          "type": "string"
        },
        "warm_timings": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "type",
        "generation",
        "device",
        "protocol_version",
        "analysis_mode",
        "engine",
        "minimum_samples",
        "history_samples",
        "maximum_input_samples",
        "noise_processor",
        "warm_timings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "faces"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "manual": {
                "type": "boolean"
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": "number"
                    },
                    "box": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "timestamp",
                    "box"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "manual",
              "observations"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "generation",
        "tracks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "selected"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "generation",
        "target_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "start_sample": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "sample_count": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "sample_rate": {
          "type": "number",
          "const": 16000
        },
        "capture_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_sample": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "end_sample": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "capture_time": {
                "type": "number"
              }
            },
            "required": [
              "start_sample",
              "end_sample",
              "capture_time"
            ],
            "additionalProperties": false
          }
        },
        "device": {
          "type": "string"
        },
        "timings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "queued_windows": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pcm": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "generation",
        "start_sample",
        "sample_count",
        "sample_rate",
        "capture_spans",
        "device",
        "timings",
        "queued_windows",
        "pcm"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "flow"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "string",
          "enum": [
            "pause",
            "resume"
          ]
        },
        "queued_windows": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "generation",
        "action",
        "queued_windows",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "drained"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "source_end_sample": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "generation",
        "source_end_sample"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "generation"
      ],
      "additionalProperties": false
    }
  ]
}
