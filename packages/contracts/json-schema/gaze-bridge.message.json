{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "device.status"
        },
        "protocolVersion": {
          "type": "string"
        },
        "tracker": {
          "type": "string",
          "enum": [
            "CONNECTED",
            "DISCONNECTED"
          ]
        },
        "calibrated": {
          "type": "boolean"
        },
        "audioFocus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "IDLE",
            "UNAVAILABLE"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "HARD_OF_HEARING",
            "DEAF"
          ]
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "tracker",
        "calibrated",
        "audioFocus",
        "mode",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.zone"
        },
        "zone": {
          "type": "string",
          "enum": [
            "SCREEN",
            "BOARD",
            "PERSON",
            "AWAY",
            "UNKNOWN"
          ]
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "zone",
        "targetId",
        "confidence",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.point"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.scene"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "valid": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "valid",
        "confidence",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.targets"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "TEACHER",
                  "PEER",
                  "UNKNOWN"
                ]
              },
              "azimuthDeg": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "azimuthDeg"
            ],
            "additionalProperties": false
          }
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "targets",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio.focus"
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "targetId",
        "label",
        "locked",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "calibration.progress"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalSteps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "instruction": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "step",
        "totalSteps",
        "instruction",
        "target",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "calibration.result"
        },
        "ok": {
          "type": "boolean"
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "message": {
          "type": "string"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "ok",
        "quality",
        "message",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "ts"
      ],
      "additionalProperties": false
    }
  ]
}
