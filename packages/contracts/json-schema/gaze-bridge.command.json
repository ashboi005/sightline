{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "client": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "client",
        "protocolVersion"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "calibration.start"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "calibration.confirm"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "step"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "calibration.cancel"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mode.set"
        },
        "mode": {
          "type": "string",
          "enum": [
            "HARD_OF_HEARING",
            "DEAF"
          ]
        }
      },
      "required": [
        "type",
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio.focus.lock"
        },
        "targetId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "targetId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio.focus.unlock"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.point.subscribe"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "enabled"
      ],
      "additionalProperties": false
    }
  ]
}
