{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^tok_.*",
      "description": "ID with \"tok_\" prefix"
    },
    "gloss": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "SIGN",
        "FINGERSPELL",
        "NUMBER"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix epoch milliseconds"
    }
  },
  "required": [
    "id",
    "gloss",
    "kind",
    "confidence",
    "ts"
  ],
  "additionalProperties": false
}
