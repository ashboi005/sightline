{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "configure"
        },
        "protocol_version": {
          "type": "number",
          "const": 3
        },
        "sample_rate": {
          "type": "number",
          "const": 16000
        },
        "audio": {
          "type": "boolean",
          "const": true
        },
        "source": {
          "type": "string",
          "enum": [
            "camera",
            "network",
            "replay"
          ]
        },
        "sync_verified": {
          "type": "boolean",
          "const": true
        },
        "video_offset_ms": {
          "type": "number",
          "minimum": -500,
          "maximum": 500
        },
        "client_time": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "protocol_version",
        "sample_rate",
        "audio",
        "source",
        "sync_verified",
        "video_offset_ms",
        "client_time"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "target"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "replay_start_sample": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "generation",
        "target_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "region"
        },
        "box": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "box"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pause"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resume"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "heartbeat"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "end"
        },
        "source_end_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "source_end_sample"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stop"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
