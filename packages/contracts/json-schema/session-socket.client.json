{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio.start"
        },
        "format": {
          "type": "object",
          "properties": {
            "encoding": {
              "type": "string",
              "const": "LINEAR16"
            },
            "sampleRate": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 16000
                },
                {
                  "type": "number",
                  "const": 48000
                }
              ]
            },
            "channels": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "encoding",
            "sampleRate",
            "channels"
          ],
          "additionalProperties": false
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "format",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio.stop"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.transition"
        },
        "transition": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "SCREEN",
                "BOARD",
                "PERSON",
                "AWAY",
                "UNKNOWN"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "SCREEN",
                "BOARD",
                "PERSON",
                "AWAY",
                "UNKNOWN"
              ]
            },
            "targetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "ts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Unix epoch milliseconds"
            }
          },
          "required": [
            "from",
            "to",
            "targetId",
            "ts"
          ],
          "additionalProperties": false
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "transition",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "ts"
      ],
      "additionalProperties": false
    }
  ]
}
