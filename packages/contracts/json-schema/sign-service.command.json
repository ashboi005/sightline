{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stream.start"
        },
        "protocolVersion": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "SELF",
            "PEER"
          ]
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "source",
        "fps",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "frame"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "image": {
          "type": "string"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        }
      },
      "required": [
        "type",
        "seq",
        "image",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stream.stop"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "phrase.reset"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
