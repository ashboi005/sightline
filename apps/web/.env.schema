# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# WebSocket base for the server realtime gateway (ws:// or wss://). Leave empty to derive it from
# NEXT_PUBLIC_SERVER_URL (https://api.x → wss://api.x). Baked in at build time, like every NEXT_PUBLIC_ value.
# @public @optional
NEXT_PUBLIC_SERVER_WS_URL=

# Arun's local gaze + audio-focus bridge (runs on the student's laptop)
# @public
NEXT_PUBLIC_GAZE_BRIDGE_URL=ws://localhost:7777

# Harnoor's sign recognition service
# @public
NEXT_PUBLIC_SIGN_SERVICE_URL=ws://localhost:7788/ws

# Local look-to-hear speaker service (apps/speaker-service, or `bun run mock:speaker`)
# @public
NEXT_PUBLIC_SPEAKER_SERVICE_URL=ws://127.0.0.1:7799/live
