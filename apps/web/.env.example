# Copy to apps/web/.env (git-ignored). Schema: apps/web/.env.schema
# Prod (Coolify): https://api.<your-domain> and wss://api.<your-domain>
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# true = no server needed: sign-in and data come from src/mocks
NEXT_PUBLIC_MOCK_MODE=false
NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:3000
# Local services on the student's laptop (stay localhost even in production)
NEXT_PUBLIC_GAZE_BRIDGE_URL=ws://localhost:7777
NEXT_PUBLIC_SIGN_SERVICE_URL=ws://localhost:7788/ws
NEXT_PUBLIC_SPEAKER_SERVICE_URL=ws://127.0.0.1:7799/live
