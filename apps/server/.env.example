# Copy to apps/server/.env (git-ignored). Every variable is documented in apps/server/.env.schema.
# In production (Coolify) set the same keys on the server app.

# --- Core server --------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of this server (asset/audio URLs are built from it). Prod: https://api.<your-domain>
PUBLIC_SERVER_URL=http://localhost:3000
# Exact web origin allowed by CORS + cookies. Prod: https://<your-domain>
CORS_ORIGIN=http://localhost:3001

# --- Auth (better-auth) ---------------------------------------------------------
# 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32+-char-random-string-xxxxxxxx
# Same as PUBLIC_SERVER_URL
BETTER_AUTH_URL=http://localhost:3000
# Prod only: parent domain of web + API (e.g. sightline.app) so the cookie reaches the web app. Empty locally.
AUTH_COOKIE_DOMAIN=

# --- Postgres (Tushar's persistence; you deploy it) -----------------------------
# Local: bun run infra:up. Prod: Coolify Postgres internal URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/sightline

# --- Mock switches --------------------------------------------------------------
# Master switch. Empty per-module flags inherit it; set true/false to force one module.
USE_MOCK_DATA=true
# core (Ashwath)
MOCK_CAPTIONS=
MOCK_SPEECH=
# surrounding (Tushar)
MOCK_KNOWLEDGE=
MOCK_NOTES=
MOCK_PERSISTENCE=
MOCK_SLIDES=
MOCK_AUTH=
MOCK_REPLAY_SPEED=1

# --- Speech (Ashwath) -----------------------------------------------------------
# elevenlabs (Scribe realtime, default) | sarvam (Hinglish codemix) | deepgram (English)
STT_PROVIDER=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# en, or hi for Hinglish
ELEVENLABS_STT_LANGUAGE=en
ELEVENLABS_STT_VAD_SILENCE_SECS=0.6
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE=hi-IN
# elevenlabs | sarvam
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
SARVAM_LANGUAGE=en-IN
# english | hinglish (for Hinglish replies use TTS_PROVIDER=sarvam + SARVAM_LANGUAGE=hi-IN)
SIGN_OUTPUT_LANGUAGE=english

# --- LLMs via Merge Gateway (OpenAI-compatible; model ids from the gateway catalog) ----
MERGE_GATEWAY_API_KEY=
LLM_GATEWAY_URL=https://api-gateway.merge.dev/v1/openai
CAPTION_MODEL=google/gemini-3.5-flash-lite,xai/grok-4.20-0309-non-reasoning,zai/glm-5.3-flash
CAPTION_TIMEOUT_MS=6000
LLM_HEDGE_MS=2500
CAPTIONS_USE_RAG=false
SIGN_MODEL=xai/grok-4.20-0309-non-reasoning,google/gemini-3.5-flash-lite,zai/glm-5.3-flash
VISION_MODEL=google/gemini-3.5-flash-lite,zai/glm-4.5v
LLM_MODEL=google/gemini-3.1-flash-lite,xai/grok-4.20-0309-non-reasoning,zai/glm-5.3-flash
PLATFORM_LLM_TIMEOUT_MS=45000
# Embeddings for Tushar's RAG: Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Qdrant (Tushar's RAG; you deploy it) ---------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Storage (assets + session recordings; presigned-URL uploads) ----------------
# local (dev: disk + signed URLs from this server) | s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/uploads
STORAGE_URL_TTL_SECONDS=3600
S3_BUCKET=
# AWS region, or auto for R2
S3_REGION=us-east-1
# R2/MinIO endpoint; empty for AWS
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
