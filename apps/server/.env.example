# Copy to apps/server/.env (git-ignored). Full schema + docs: apps/server/.env.schema
BETTER_AUTH_SECRET=replace-with-32+-char-random-string-xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/sightline

# Master mock switch — true lets everyone work with zero external services
USE_MOCK_DATA=true
# Optional per-module overrides (empty = follow USE_MOCK_DATA)
# core (Ashwath)
MOCK_CAPTIONS=
MOCK_SPEECH=
# surrounding (Tushar)
MOCK_KNOWLEDGE=
MOCK_NOTES=
MOCK_PERSISTENCE=
MOCK_SLIDES=
MOCK_AUTH=
MOCK_REPLAY_SPEED=1

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SARVAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
SLIDE_POINTER_THRESHOLD=0.5
SLIDE_POINTER_MARGIN=0.1
