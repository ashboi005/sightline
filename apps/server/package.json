{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "smoke": "bun scripts/smoke.ts",
    "test": "bun test src",
    "eval:captions": "bun scripts/eval-captions.ts",
    "check:pipeline": "bun scripts/pipeline-check.ts",
    "check:providers": "bun scripts/check-providers.ts",
    "check:auth": "bun scripts/auth-check.ts",
    "check:e2e": "bun scripts/e2e-live.ts",
    "bench:models": "bun scripts/bench-models.ts",
    "demo:rehearse": "bun scripts/demo-rehearse.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@mastra/core": "^1.79.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "@sightline/auth": "workspace:*",
    "@sightline/contracts": "workspace:*",
    "@sightline/db": "workspace:*",
    "@sightline/mocks": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "^1.4.30",
    "openai": "^7.42.0",
    "katex": "^0.19.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sightline/config": "workspace:*",
    "@sightline/live-client": "workspace:*",
    "@types/bun": "catalog:",
    "fflate": "^0.8.3",
    "@types/katex": "^0.16.8",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
