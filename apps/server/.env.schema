# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# @public @type=port
PORT=3000

# Public base URL of this server (used to build slide/audio asset URLs)
# @public @type=url
PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mock mode — see docs/00-overview.md#mock-mode
# USE_MOCK_DATA is the master switch. Each MOCK_* override is optional:
# leave it empty to inherit USE_MOCK_DATA, or set true/false to force a module.
# ---------------------------------------------------------------------------

# @public @type=boolean
USE_MOCK_DATA=true

# Ashwath's module (RAG, caption refinement, formulas, notes, sign sentences)
# @public @optional @type=boolean
MOCK_INTELLIGENCE=

# Tushar's speech adapters (Deepgram STT replay + ElevenLabs/Sarvam TTS)
# @public @optional @type=boolean
MOCK_SPEECH=

# Tushar's persistence (in-memory store instead of Postgres)
# @public @optional @type=boolean
MOCK_PERSISTENCE=

# Skip better-auth on /api routes and act as a fixed demo user
# @public @optional @type=boolean
MOCK_AUTH=

# Mock caption replay speed multiplier (1 = real lecture pace, 4 = 4x faster)
# @public @type=number
MOCK_REPLAY_SPEED=1

# ---------------------------------------------------------------------------
# Speech — Deepgram (STT), ElevenLabs / Sarvam (TTS)
# ---------------------------------------------------------------------------

# @optional
DEEPGRAM_API_KEY=

# @public
DEEPGRAM_MODEL=nova-3

# @public @type=enum(elevenlabs, sarvam)
TTS_PROVIDER=elevenlabs

# @optional
ELEVENLABS_API_KEY=

# @public @optional
ELEVENLABS_VOICE_ID=

# @optional
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Intelligence — LLM + Qdrant (self-hosted) + Mastra
# ---------------------------------------------------------------------------

# @optional
OPENAI_API_KEY=

# @optional
ANTHROPIC_API_KEY=

# Mastra model id, e.g. "openai/gpt-4.1-mini" or "anthropic/claude-sonnet-5-5"
# @public
LLM_MODEL=openai/gpt-4.1-mini

# @public
EMBEDDING_MODEL=openai/text-embedding-3-small

# @public @type=url
QDRANT_URL=http://localhost:6333

# @optional
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Storage (uploaded slides, rendered slide images, TTS audio)
# ---------------------------------------------------------------------------

# @public
STORAGE_DIR=./.data/uploads
