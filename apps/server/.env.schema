# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# @public @type=port
PORT=3000

# Public base URL of this server (used to build slide/audio asset URLs)
# @public @type=url
PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mock mode — see docs/00-overview.md#mock-mode
# USE_MOCK_DATA is the master switch. Each MOCK_* override is optional:
# leave it empty to inherit USE_MOCK_DATA, or set true/false to force a module.
# ---------------------------------------------------------------------------

# @public @type=boolean
USE_MOCK_DATA=true

# --- Core (Ashwath) ---
# Caption refinement + spoken formulas + sign sentence composer (Mastra LLM)
# @public @optional @type=boolean
MOCK_CAPTIONS=

# Speech adapters: Deepgram STT (replay of a scripted lecture when mocked) + ElevenLabs/Sarvam TTS
# @public @optional @type=boolean
MOCK_SPEECH=

# --- Surrounding (Tushar) ---
# RAG over lecture context (Qdrant) + glossary
# @public @optional @type=boolean
MOCK_KNOWLEDGE=

# Post-lecture notes generation
# @public @optional @type=boolean
MOCK_NOTES=

# Persistence (in-memory store instead of Postgres)
# @public @optional @type=boolean
MOCK_PERSISTENCE=

# Slide pipeline (fixture deck rendered as SVG instead of parsing the upload)
# @public @optional @type=boolean
MOCK_SLIDES=

# Skip better-auth on /api routes and act as a fixed demo user
# @public @optional @type=boolean
MOCK_AUTH=

# Mock caption replay speed multiplier (1 = real lecture pace, 4 = 4x faster)
# @public @type=number
MOCK_REPLAY_SPEED=1

# ---------------------------------------------------------------------------
# Speech (core — Ashwath). Used when MOCK_SPEECH=false.
# ---------------------------------------------------------------------------

# Which streaming STT transcribes the lecture:
#   elevenlabs — Scribe v2 Realtime (word-by-word partials, keyterms, Hindi+English code-switching)
#   sarvam     — saaras codemix (Hinglish / Indian languages, utterance-level)
#   deepgram   — Nova-3 (English, keyterm prompting)
# @public @type=enum(elevenlabs, sarvam, deepgram)
STT_PROVIDER=elevenlabs

# ElevenLabs Scribe realtime model (uses ELEVENLABS_API_KEY)
# @public
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Scribe language: en, or hi for Hinglish (English is then allowed as a secondary language)
# @public @type=enum(en, hi)
ELEVENLABS_STT_LANGUAGE=en

# Silence before Scribe commits a caption line (0.3–3.0 s): lower = snappier, higher = fewer split sentences
# @public @type=number
ELEVENLABS_STT_VAD_SILENCE_SECS=0.6

# Override the ElevenLabs API base (tests). Default: https://api.elevenlabs.io
# @public @optional
ELEVENLABS_URL=

# Sarvam streaming STT (used when STT_PROVIDER=sarvam). codemix = Hindi in Devanagari + English words kept in Latin.
# Other modes: transcribe, translate (→ English captions), translit (Roman script), verbatim.
# @public
SARVAM_STT_MODEL=saaras:v3

# @public @type=enum(transcribe, translate, verbatim, translit, codemix)
SARVAM_STT_MODE=codemix

# BCP-47 (hi-IN for Hinglish, en-IN, ta-IN, …) or "unknown" for auto-detect
# @public
SARVAM_STT_LANGUAGE=hi-IN

# Override the Sarvam websocket base (tests). Default: wss://api.sarvam.ai
# @public @optional
SARVAM_STT_URL=

# Deepgram streaming STT — https://console.deepgram.com
# @optional
DEEPGRAM_API_KEY=

# @public
DEEPGRAM_MODEL=nova-3

# Override the Deepgram websocket base (tests / a regional endpoint). Default: wss://api.deepgram.com
# @public @optional
DEEPGRAM_URL=

# BCP-47 language for STT (keyterm prompting needs a monolingual Nova-3 model, e.g. "en")
# @public
DEEPGRAM_LANGUAGE=en

# Which TTS speaks sign-language sentences aloud
# @public @type=enum(elevenlabs, sarvam)
TTS_PROVIDER=elevenlabs

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# @optional
ELEVENLABS_API_KEY=

# Default: "George" premade voice. Any voice id from your ElevenLabs voice library works.
# @public
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Low-latency model
# @public
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Sarvam (STT + TTS for Indian English, Hinglish and Indian languages) — https://dashboard.sarvam.ai
# @optional
SARVAM_API_KEY=

# @public
SARVAM_TTS_MODEL=bulbul:v3

# Language the sign composer writes spoken replies in: english, or hinglish (Roman-script Hindi-English mix;
# pair with TTS_PROVIDER=sarvam and SARVAM_LANGUAGE=hi-IN)
# @public @type=enum(english, hinglish)
SIGN_OUTPUT_LANGUAGE=english

# Must be valid for SARVAM_TTS_MODEL (bulbul:v3 default speaker: shubh)
# @public
SARVAM_SPEAKER=shubh

# @public
SARVAM_LANGUAGE=en-IN

# ---------------------------------------------------------------------------
# LLMs — all chat/vision calls go through Merge Gateway (OpenAI-compatible). Model ids are gateway ids
# ("vendor/model", see https://docs.merge.dev/merge-gateway/models).
# ---------------------------------------------------------------------------

# https://gateway.merge.dev — keys start with mg_
# @optional
MERGE_GATEWAY_API_KEY=

# @public @type=url
LLM_GATEWAY_URL=https://api-gateway.merge.dev/v1/openai

# Core (Ashwath): caption correction + spoken formulas — must be FAST (< 1.5 s p95)
# @public
CAPTION_MODEL=zai/glm-5.3-flash

# Deadline for one LLM caption refinement; on timeout the glossary-only correction is kept. Refinement is async:
# the raw caption shows instantly and the corrected line replaces it. GLM 5.3 Flash via Merge measured ~2–4 s.
# @public @type=number
CAPTION_TIMEOUT_MS=6000

# Ground caption correction with Tushar's RAG retrieval (KnowledgeEngine.retrieveContext). Glossary is always used.
# @public @type=boolean
CAPTIONS_USE_RAG=false

# Core (Ashwath): sign gloss → sentence
# @public
SIGN_MODEL=zai/glm-5.3-flash

# Core (Ashwath): describes board/diagram snapshots for the notes
# @public
VISION_MODEL=zai/glm-4.5v

# Surrounding (Tushar): notes + glossary agent (through Merge Gateway)
# @public
LLM_MODEL=zai/glm-5.3-flash

# Surrounding (Tushar): RAG embeddings — Gemini via its OpenAI-compatible endpoint
# @optional
GEMINI_API_KEY=

# @public @type=url
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# @public
EMBEDDING_MODEL=gemini-embedding-001

# Vector size of the Qdrant collections (changing it requires re-ingesting)
# @public @type=number
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Qdrant (surrounding — Tushar). Local: `bun run infra:up`. Production: Coolify service.
# ---------------------------------------------------------------------------

# @public @type=url
QDRANT_URL=http://localhost:6333

# @optional
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Storage — assets (decks, slide images, TTS audio, snapshots) + session recordings.
# Uploads use presigned URLs: the browser PUTs straight to storage, never through the API server.
# ---------------------------------------------------------------------------

# local = files under STORAGE_DIR with HMAC-signed URLs served by this server (dev / mocks)
# s3    = any S3-compatible store (AWS S3, Cloudflare R2, MinIO)
# @public @type=enum(local, s3)
STORAGE_DRIVER=local

# @public
STORAGE_DIR=./.data/uploads

# Lifetime of presigned upload/download URLs
# @public @type=number
STORAGE_URL_TTL_SECONDS=3600

# @public @optional
S3_BUCKET=

# AWS region, or "auto" for Cloudflare R2
# @public
S3_REGION=us-east-1

# Custom endpoint for R2 / MinIO (leave empty for AWS), e.g. https://<account>.r2.cloudflarestorage.com
# @public @optional
S3_ENDPOINT=

# @optional
S3_ACCESS_KEY_ID=

# @optional
S3_SECRET_ACCESS_KEY=
