# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# @public @type=port
PORT=3000

# Public base URL of this server (used to build slide/audio asset URLs)
# @public @type=url
PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mock mode — see docs/00-overview.md#mock-mode
# USE_MOCK_DATA is the master switch. Each MOCK_* override is optional:
# leave it empty to inherit USE_MOCK_DATA, or set true/false to force a module.
# ---------------------------------------------------------------------------

# @public @type=boolean
USE_MOCK_DATA=true

# --- Core (Ashwath) ---
# Caption refinement + spoken formulas + sign sentence composer (Mastra LLM)
# @public @optional @type=boolean
MOCK_CAPTIONS=

# Speech adapters: Deepgram STT (replay of a scripted lecture when mocked) + ElevenLabs/Sarvam TTS
# @public @optional @type=boolean
MOCK_SPEECH=

# --- Surrounding (Tushar) ---
# RAG over lecture context (Qdrant) + glossary
# @public @optional @type=boolean
MOCK_KNOWLEDGE=

# Post-lecture notes generation
# @public @optional @type=boolean
MOCK_NOTES=

# Persistence (in-memory store instead of Postgres)
# @public @optional @type=boolean
MOCK_PERSISTENCE=

# Slide pipeline (fixture deck rendered as SVG instead of parsing the upload)
# @public @optional @type=boolean
MOCK_SLIDES=

# Skip better-auth on /api routes and act as a fixed demo user
# @public @optional @type=boolean
MOCK_AUTH=

# Mock caption replay speed multiplier (1 = real lecture pace, 4 = 4x faster)
# @public @type=number
MOCK_REPLAY_SPEED=1

# ---------------------------------------------------------------------------
# Speech (core — Ashwath). Used when MOCK_SPEECH=false.
# ---------------------------------------------------------------------------

# Deepgram streaming STT — https://console.deepgram.com
# @optional
DEEPGRAM_API_KEY=

# @public
DEEPGRAM_MODEL=nova-3

# BCP-47 language for STT (keyterm prompting needs a monolingual Nova-3 model, e.g. "en")
# @public
DEEPGRAM_LANGUAGE=en

# Which TTS speaks sign-language sentences aloud
# @public @type=enum(elevenlabs, sarvam)
TTS_PROVIDER=elevenlabs

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# @optional
ELEVENLABS_API_KEY=

# Default: "George" premade voice. Any voice id from your ElevenLabs voice library works.
# @public
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Low-latency model
# @public
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Sarvam (Indian English + Indian languages) — https://dashboard.sarvam.ai
# @optional
SARVAM_API_KEY=

# @public
SARVAM_TTS_MODEL=bulbul:v3

# Must be valid for SARVAM_TTS_MODEL (bulbul:v3 default speaker: shubh)
# @public
SARVAM_SPEAKER=shubh

# @public
SARVAM_LANGUAGE=en-IN

# ---------------------------------------------------------------------------
# LLMs via Mastra model router ("provider/model"). Set the key for every provider you reference.
# ---------------------------------------------------------------------------

# @optional
OPENAI_API_KEY=

# @optional
ANTHROPIC_API_KEY=

# @optional
GOOGLE_GENERATIVE_AI_API_KEY=

# @optional
GROQ_API_KEY=

# Core (Ashwath): caption correction + spoken formulas — must be FAST (< 1.5 s p95)
# @public
CAPTION_MODEL=openai/gpt-4.1-mini

# Hard deadline for one caption refinement; on timeout the glossary-only correction is used
# @public @type=number
CAPTION_TIMEOUT_MS=1500

# Ground caption correction with Tushar's RAG retrieval (KnowledgeEngine.retrieveContext). Glossary is always used.
# @public @type=boolean
CAPTIONS_USE_RAG=false

# Core (Ashwath): sign gloss → sentence
# @public
SIGN_MODEL=openai/gpt-4.1-mini

# Surrounding (Tushar): notes + glossary agent
# @public
LLM_MODEL=openai/gpt-4.1-mini

# Surrounding (Tushar): embeddings for the RAG index
# @public
EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------------------------------------------------------------------------
# Qdrant (surrounding — Tushar). Local: `bun run infra:up`. Production: Coolify service.
# ---------------------------------------------------------------------------

# @public @type=url
QDRANT_URL=http://localhost:6333

# @optional
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Storage (uploaded slides, rendered slide images, TTS audio)
# ---------------------------------------------------------------------------

# @public
STORAGE_DIR=./.data/uploads
