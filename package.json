{
  "name": "sightline",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "better-auth": "1.7.7",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "dev:demo": "bun scripts/dev-demo.ts",
    "live": "bun scripts/live.ts",
    "db:push": "bun run --filter @sightline/db db:push",
    "db:studio": "bun run --filter @sightline/db db:studio",
    "db:generate": "bun run --filter @sightline/db db:generate",
    "db:migrate": "bun run --filter @sightline/db db:migrate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "mock:gaze": "bun run --filter @sightline/mocks gaze",
    "mock:sign": "bun run --filter @sightline/mocks sign",
    "mock:validate": "bun run --filter @sightline/mocks validate",
    "contracts:json-schema": "bun run --filter @sightline/contracts json-schema",
    "speaker:setup": "cd apps/speaker-service && uv sync --frozen && uv run python -m sightline_speaker.assets",
    "speaker:dev": "cd apps/speaker-service && uv run sightline-speaker --device auto",
    "speaker:test": "cd apps/speaker-service && uv run pytest -q",
    "mock:speaker": "bun run --filter @sightline/mocks speaker",
    "gaze:dev": "cd apps/gaze-bridge && uv run gaze-bridge --tracker fake",
    "gaze:test": "cd apps/gaze-bridge && uv run pytest -q",
    "mobile:apk": "cd apps/mobile && ./scripts/android.sh :app:assembleDebug",
    "mobile:install": "cd apps/mobile && ./scripts/android.sh :app:installDebug",
    "mobile:check": "cd apps/mobile && ./scripts/android.sh :app:testDebugUnitTest :app:lintDebug",
    "sign:setup": "bun scripts/sign-service.ts setup",
    "sign:dev": "bun scripts/sign-service.ts dev",
    "sign:test": "bun scripts/sign-service.ts test",
    "sign:verify": "bun scripts/sign-service.ts verify",
    "sign:camera": "bun scripts/sign-service.ts camera",
    "sign:eval": "bun scripts/sign-service.ts eval",
    "sign:check-compose": "bun scripts/check-sign-compose.ts",
    "sign:tunnel": "bun --env-file=.env.local scripts/sign-tunnel.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sightline/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2",
    "uuid": "11.1.1"
  },
  "packageManager": "bun@1.4.4"
}
